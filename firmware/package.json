{
  "name": "stack-chan",
  "version": "0.2.1",
  "description": "A firmware of M5Stack Stack-chan module",
  "main": "stackchan/main.ts",
  "scripts": {
    "format": "biome format stackchan mods tests scripts",
    "format:fix": "npm run format -- --write",
    "format:breath": "cd ../.. && stack-chan/firmware/node_modules/.bin/biome format --config-path biome.json overlay/mods stack-chan/firmware/stackchan/breath-policy-loader.ts stack-chan/firmware/stackchan/main-breath.ts",
    "format:breath:fix": "npm run format:breath -- --write",
    "lint": "biome lint stackchan mods tests scripts",
    "lint:fix": "npm run lint -- --write",
    "check:breath": "cd ../.. && stack-chan/firmware/node_modules/.bin/biome check --config-path biome.json --error-on-warnings overlay/mods stack-chan/firmware/stackchan/breath-policy-loader.ts stack-chan/firmware/stackchan/main-breath.ts && stack-chan/firmware/node_modules/.bin/tsc --project stack-chan/firmware/tsconfig.breath.json",
    "extract-font-chars": "node scripts/extract-font-chars.js",
    "generate-speech-coqui": "node scripts/generate-speech-coqui.js",
    "generate-speech-voicevox": "node scripts/generate-speech-voicevox.js",
    "generate-speech-google": "cross-env GOOGLE_APPLICATION_CREDENTIALS=scripts/key.json node scripts/generate-speech-google.js",
    "generate-apidoc": "node --experimental-loader ./scripts/typedoc-ts6-loader.mjs ./node_modules/typedoc/bin/typedoc --skipErrorChecking --entryPointStrategy expand --plugin typedoc-plugin-markdown --out docs/api ./stackchan",
    "test": "npm run test:unit",
    "test:unit": "rm -rf dist-tests && tsc --project tsconfig.test.json && node --test \"dist-tests/tests/unit/**/*.test.js\" \"dist-tests/stackchan/drivers/__tests__/**/*.test.js\"",
    "build": "cross-env npm_config_target?=esp32/m5stack cross-env-shell mcconfig -d -m -p \\$npm_config_target -t build \"$PWD/stackchan/manifest_local.json\"",
    "build:lin": "mcconfig -d -m -p lin -t build \"$PWD/stackchan/manifest_local.json\"",
    "smoke:lin": "bash scripts/smoke-lin.sh",
    "build:wasm": "mcconfig -d -m -p wasm -t build \"$PWD/stackchan/manifest_wasm.json\" && mkdir -p ../web/simulator && cp $MODDABLE/build/bin/wasm/debug/stackchan/mc.js $MODDABLE/build/bin/wasm/debug/stackchan/mc.wasm ../web/simulator/",
    "bundle": "mcbundle -d -m \"$PWD/stackchan/manifest.json\"",
    "deploy": "cross-env npm_config_target?=esp32/m5stack cross-env-shell mcconfig -d -m -p \\$npm_config_target -t deploy \"$PWD/stackchan/manifest_local.json\"",
    "debug": "cross-env npm_config_target?=esp32/m5stack cross-env-shell mcconfig -d -m -p \\$npm_config_target \"$PWD/stackchan/manifest_local.json\"",
    "mod": "cross-env npm_config_target?=esp32/m5stack cross-env-shell mcrun -d -m -p \\$npm_config_target",
    "build:m5stackchan-cores3": "mcconfig -d -m -p esp32:./platforms/m5stackchan_cores3 -t build \"$PWD/stackchan/manifest_m5stackchan_cores3.json\"",
    "deploy:m5stackchan-cores3": "mcconfig -d -m -p esp32:./platforms/m5stackchan_cores3 -t deploy \"$PWD/stackchan/manifest_m5stackchan_cores3.json\"",
    "debug:m5stackchan-cores3": "mcconfig -d -m -p esp32:./platforms/m5stackchan_cores3 \"$PWD/stackchan/manifest_m5stackchan_cores3.json\"",
    "mod:m5stackchan-cores3": "bash scripts/mod-cores3.sh",
    "build:breath:m5stackchan-cores3": "npm run check:breath && mcconfig -d -m -p esp32:./platforms/m5stackchan_cores3 -t build \"$PWD/stackchan/manifest_breath_deploy.json\"",
    "deploy:breath:m5stackchan-cores3": "npm run check:breath && mcconfig -d -m -p esp32:./platforms/m5stackchan_cores3 -t deploy \"$PWD/stackchan/manifest_breath_deploy.json\"",
    "build:breath-release:m5stackchan-cores3": "npm run check:breath && mcconfig -m -p esp32:./platforms/m5stackchan_cores3 -t build \"$PWD/stackchan/manifest_breath_deploy.json\"",
    "deploy:breath-release:m5stackchan-cores3": "npm run check:breath && mcconfig -m -p esp32:./platforms/m5stackchan_cores3 -t deploy \"$PWD/stackchan/manifest_breath_deploy.json\"",
    "setup": "xs-dev setup",
    "update": "xs-dev update",
    "doctor": "echo stack-chan environment info: && git rev-parse HEAD && git rev-parse --show-toplevel && xs-dev doctor",
    "scan": "xs-dev scan",
    "erase-flash": "esptool erase-flash",
    "install-hook": "lefthook install",
    "uninstall-hook": "lefthook uninstall"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/meganetaaan/stack-chan.git"
  },
  "keywords": [
    "M5Stack",
    "Robot",
    "Moddable",
    "Kawaii"
  ],
  "author": "Shinya Ishikawa",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/meganetaaan/stack-chan/issues"
  },
  "homepage": "https://github.com/meganetaaan/stack-chan#readme",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@microsoft/tsdoc": "^0.16.0",
    "@moddable/typings": "^8.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript/typescript6": "6.0.2",
    "cross-env-default": "^5.1.3-1",
    "fontkit": "^2.0.2",
    "lefthook": "^2.1.9",
    "node-fetch": "^3.3.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "7.0.2",
    "web-audio-engine": "^0.13.4",
    "xs-dev": "^1.12.1",
    "yargs": "^18.0.0"
  }
}
