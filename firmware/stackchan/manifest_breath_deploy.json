      "yawZeroPosition": 460,
      "pitchZeroPosition": 620,
      "serial": {
        "transmit": 6,
        "receive": 7,
        "port": 1,
        "baud": 1000000
      }
    },
    "gazeServoFollowDeg": 45,
    "breathServoPositionPolling": false
  },
  "defines": {
    "ota": {
      "autosplit": 1
    },
